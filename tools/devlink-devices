#!/usr/bin/env python3
"""List DevLink devices for humans or agents. This API is local to the origin."""
import argparse,json,sys,urllib.request

def main():
 p=argparse.ArgumentParser(description=__doc__)
 p.add_argument('--json',action='store_true',help='Machine-readable records; no credentials')
 p.add_argument('--connected',action='store_true',help='Show only devices with active reverse tunnels')
 p.add_argument('--endpoint',default='http://127.0.0.1:18792/devices',help='Local discovery endpoint (or SSH-forwarded local endpoint)')
 a=p.parse_args();url=a.endpoint+('?connected=1' if a.connected else '')
 try:
  with urllib.request.urlopen(url,timeout=10) as r:devices=json.load(r)
 except Exception as e:print(f'DevLink discovery unavailable: {e}',file=sys.stderr);return 1
 if a.json:json.dump(devices,sys.stdout,indent=2);print();return 0
 for d in devices:
  status='CONNECTED' if d['connected'] else 'revoked' if d['revoked'] else 'offline'
  print(f"{status:9} {d['id']} {d['label']!r} lanes={d['active_lanes']}")
  print(f"  ssh -p {d['ssh_port']} {d['ssh_user']}@{d['ssh_host']}")
  if d['adb_forwarding']:print(f"  adb connect {d['adb_host']}:{d['adb_port']}")
 if not devices:print('No matching devices.')
 return 0
if __name__=='__main__':sys.exit(main())

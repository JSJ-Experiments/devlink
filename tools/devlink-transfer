#!/usr/bin/env python3
"""Resumable parallel-chunk file transfers over ordinary SSH (no SFTP needed).

Re-run exactly the same command to resume. Ctrl-C leaves verified chunks in
place. Network failures automatically pause/retry with bounded backoff.
"""
import argparse
import concurrent.futures
import contextlib
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import threading
import tempfile
import time

STOP = threading.Event()
PRINT_LOCK = threading.Lock()

def say(message):
    with PRINT_LOCK:
        print(message, file=sys.stderr, flush=True)

def digest(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()

def atomic_json(path, value):
    tmp = path.with_suffix('.tmp')
    with open(tmp, 'w') as f:
        json.dump(value, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)

class Cancelled(Exception):
    pass

class SSH:
    def __init__(self, args, stop=STOP):
        self.stop = stop
        self.args = args
        self.ports = [args.port]
        self.cursor = 0
        self.lane_lock = threading.Lock()
        self.command = ['ssh', '-T', '-p', str(args.port), '-o', 'BatchMode=yes',
                        '-o', 'ConnectTimeout=10', '-o', 'StrictHostKeyChecking=accept-new', '-o', 'ServerAliveInterval=10',
                        '-o', 'ServerAliveCountMax=2', '-o', 'ControlMaster=no', '-o', 'ControlPath=none']
        if args.identity:
            self.command += ['-i', args.identity]
        self.command += [f'{args.user}@{args.host}']

    def run(self, script, data=None):
        delay, attempt = 1, 0
        while not self.stop.is_set():
            attempt += 1
            with self.lane_lock:
                port = self.ports[self.cursor % len(self.ports)]
                self.cursor += 1
            command = self.command.copy(); command[command.index('-p') + 1] = str(port)
            # Use a seekable file for stdin. Repeated communicate(timeout=...)
            # with input=None can stop pumping partially written PIPE input,
            # causing slow-network uploads to hang despite a healthy tunnel.
            with (tempfile.TemporaryFile() if data is not None else contextlib.nullcontext(subprocess.DEVNULL)) as source:
                if data is not None:
                    source.write(data); source.seek(0)
                with subprocess.Popen(command + [script], stdin=source,
                                      stdout=subprocess.PIPE, stderr=subprocess.PIPE) as p:
                    started = time.monotonic()
                    while True:
                        if self.stop.is_set():
                            p.kill(); p.communicate()
                            raise Cancelled()
                        try:
                            out, err = p.communicate(timeout=1)
                            break
                        except subprocess.TimeoutExpired:
                            if time.monotonic() - started > self.args.timeout:
                                p.kill(); out, err = p.communicate()
                                err += b'\nTransfer command timed out'
                                break
            if p.returncode == 0:
                return out
            msg = err.decode(errors='replace').strip()
            fatal_auth = any(s in msg for s in ('Permission denied (', 'Host key verification failed',
                                               'REMOTE HOST IDENTIFICATION HAS CHANGED'))
            if fatal_auth or p.returncode not in (255, 75, -signal.SIGKILL):
                raise RuntimeError(f'SSH command failed ({p.returncode}): {msg}')
            if self.args.retries and attempt >= self.args.retries:
                raise RuntimeError(f'Retry limit reached: {msg}')
            say(f'Connection interrupted; pausing {delay}s then retrying: {msg[-240:]}')
            if self.stop.wait(delay): raise Cancelled()
            delay = min(delay * 2, 60)
        raise Cancelled()

    def meta(self, path):
        q = shlex.quote(path)
        lines = self.run(f'test -f {q} && stat -c %s {q} && sha256sum {q}').decode().splitlines()
        if len(lines) < 2:
            raise RuntimeError('Remote stat/checksum missing')
        size, sha = int(lines[0]), lines[1].split()[0]
        if len(sha) != 64:
            raise RuntimeError('Invalid remote checksum')
        return size, sha

@contextlib.contextmanager
def job_state(args, spec):
    job = hashlib.sha256(json.dumps(spec, sort_keys=True).encode()).hexdigest()[:24]
    directory = Path(args.state_dir).expanduser() / job
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(directory / 'lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('This transfer is already running from this host')
        manifest = directory / 'manifest.json'
        if manifest.exists():
            saved = json.loads(manifest.read_text())
            if saved['spec'] != spec:
                raise RuntimeError('Transfer state does not match the source')
        else:
            saved = {'spec': spec, 'done': {}}
            atomic_json(manifest, saved)
        yield job, directory, saved, manifest

def list_next(iterator, count):
    values = []
    for _ in range(count):
        v = next(iterator, None)
        if v is None: break
        values.append(v)
    return values

def chunks(size, block):
    return range(math.ceil(size / block))

def transfer(args, ssh):
    if args.direction == 'push':
        local = Path(args.source).expanduser().resolve()
        if not local.is_file():
            raise RuntimeError('Source must be a regular file')
        remote = args.destination
        if not remote.startswith('/'):
            raise RuntimeError('Remote destination must be an absolute file path')
        size, sha = local.stat().st_size, digest(local)
    else:
        remote = args.source
        if not remote.startswith('/'):
            raise RuntimeError('Remote source must be an absolute file path')
        local = Path(args.destination).expanduser().resolve()
        size, sha = ssh.meta(remote)
    spec = dict(direction=args.direction, host=args.host, port=args.port, user=args.user,
                remote=remote, local=str(local), size=size, sha256=sha, chunk=args.chunk_size)
    with job_state(args, spec) as (job, directory, saved, manifest):
        work = args.remote_state.rstrip('/') + '/' + job
        total = math.ceil(size / args.chunk_size)
        state_lock = threading.Lock()
        def record(index, checksum):
            with state_lock:
                saved['done'][str(index)] = checksum
                atomic_json(manifest, saved)
                say(f'{len(saved["done"])}/{total} chunks verified')
        if args.direction == 'push':
            dest = shlex.quote(remote)
            # Existing complete output is idempotent, never clobbered accidentally.
            old = ssh.run(f'if test -e {dest}; then test -f {dest} && sha256sum {dest}; fi').decode().split()
            if old and old[0] == sha:
                say('Destination already matches SHA-256; complete.'); return
            if old and not args.overwrite:
                raise RuntimeError('Destination exists with different content; use --overwrite')
            ssh.run(f'umask 077; mkdir -p {shlex.quote(work)}')
            def push(index):
                if STOP.is_set(): raise Cancelled()
                with open(local, 'rb') as source:
                    source.seek(index * args.chunk_size)
                    data = source.read(min(args.chunk_size, size - index * args.chunk_size))
                checksum = hashlib.sha256(data).hexdigest()
                part = shlex.quote(f'{work}/{index:012d}.chunk')
                previous = ssh.run(f'if test -f {part}; then sha256sum {part}; fi').decode().split()
                if previous and previous[0] == checksum:
                    record(index, checksum); return
                # Transport retry is idempotent: complete chunks are atomically renamed.
                ssh.run(f'umask 077; cat > {part}.tmp && '
                        f'test "$(sha256sum {part}.tmp | cut -d " " -f 1)" = {checksum} && '
                        f'mv -f {part}.tmp {part}', data)
                record(index, checksum)
            worker = push
        else:
            if local.exists():
                if local.is_file() and digest(local) == sha:
                    say('Destination already matches SHA-256; complete.'); return
                if not args.overwrite:
                    raise RuntimeError('Destination exists with different content; use --overwrite')
            local.parent.mkdir(parents=True, exist_ok=True)
            def pull(index):
                if STOP.is_set(): raise Cancelled()
                part = directory / f'{index:012d}.chunk'
                expected = saved['done'].get(str(index))
                n = min(args.chunk_size, size - index * args.chunk_size)
                if expected and part.exists() and part.stat().st_size == n and digest(part) == expected:
                    say(f'Reusing verified chunk {index}'); return
                data = ssh.run(f'dd if={shlex.quote(remote)} bs={args.chunk_size} skip={index} count=1 2>/dev/null')
                if len(data) != n:
                    raise RuntimeError('Remote source changed or returned a truncated chunk')
                tmp = part.with_suffix('.tmp')
                with open(tmp, 'wb') as f:
                    f.write(data); f.flush(); os.fsync(f.fileno())
                os.replace(tmp, part)
                record(index, hashlib.sha256(data).hexdigest())
            worker = pull
        say(f'{args.direction}: {size} bytes, {total} chunks, {args.jobs} workers; job {job}')
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
            indices = iter(chunks(size, args.chunk_size))
            pending = {pool.submit(worker, i) for i in list_next(indices, args.jobs)}
            try:
                while pending:
                    done, pending = concurrent.futures.wait(pending, return_when=concurrent.futures.FIRST_COMPLETED)
                    for future in done:
                        future.result()
                        index = next(indices, None)
                        if index is not None: pending.add(pool.submit(worker, index))
            except BaseException:
                STOP.set()
                for future in pending: future.cancel()
                raise
        if args.direction == 'push':
            if local.stat().st_size != size or digest(local) != sha:
                raise RuntimeError('Local source changed during transfer; destination not committed')
            temp = shlex.quote(remote + '.devlink-' + job + '.tmp')
            qw = shlex.quote(work)
            assembly = f'cat {qw}/*.chunk > {temp}' if total else f': > {temp}'
            # Recheck destination immediately before commit. Temp is alongside destination.
            gate = '' if args.overwrite else f'if test -e {dest}; then test "$(sha256sum {dest} | cut -d " " -f 1)" = {sha} || exit 73; fi; '
            commit = f'mv -f {temp} {dest}' if args.overwrite else f'mv -n {temp} {dest}; test "$(sha256sum {dest} | cut -d " " -f 1)" = {sha}; rm -f {temp}'
            ssh.run(f'set -eu; umask 077; {assembly}; test "$(sha256sum {temp} | cut -d " " -f 1)" = {sha}; {gate}{commit}')
            if not args.keep_chunks: ssh.run(f'rm -rf {qw}')
        else:
            tmp = local.with_name(local.name + '.devlink-' + job + '.tmp')
            with open(tmp, 'wb') as target:
                for i in chunks(size, args.chunk_size):
                    with open(directory / f'{i:012d}.chunk', 'rb') as part:
                        for block in iter(lambda: part.read(1024 * 1024), b''): target.write(block)
                target.flush(); os.fsync(target.fileno())
            if digest(tmp) != sha or ssh.meta(remote) != (size, sha):
                tmp.unlink(missing_ok=True)
                raise RuntimeError('Remote source changed or final checksum mismatched; destination not committed')
            if local.exists() and not args.overwrite:
                if digest(local) != sha: raise RuntimeError('Destination changed during transfer; not overwritten')
            if args.overwrite:
                os.replace(tmp, local)
            else:
                try: os.link(tmp, local)
                except FileExistsError:
                    if digest(local) != sha: raise RuntimeError('Destination changed during transfer; not overwritten')
                tmp.unlink()
        if not args.keep_chunks:
            for part in directory.glob('*.chunk'): part.unlink()
        say(f'Complete. SHA-256 {sha}')

@contextlib.contextmanager
def tunnel_lanes(args, ssh):
    if args.tunnels == 1:
        yield
        return
    control = SSH(args)
    # No lane expiry by default. An explicitly requested lease is renewed while
    # this process is alive; otherwise a host crash leaves lanes enabled.
    previous = json.loads(control.run(shlex.quote(args.client) + ' status --json'))
    available = previous.get('lanes_available', 1)
    ports = [previous['ssh_port']] * available
    if args.tunnels > len(ports):
        raise RuntimeError(f"Only {len(ports)} lanes reserved; use --tunnels 1 or upgrade enrollment/server")
    requested = args.tunnels
    lease = (" " + shlex.quote(args.lane_lease)) if args.lane_lease else ""
    stopped = threading.Event()
    renew_args = argparse.Namespace(**vars(args)); renew_args.timeout=15; renew_args.retries=1
    renewal = SSH(renew_args, stop=stopped)
    control.run(shlex.quote(args.client) + f' lanes {requested}{lease}')
    ssh.ports = ports[:requested]
    def renew():
        while lease and not stopped.wait(120) and not STOP.is_set():
            try:
                renewal.run(shlex.quote(args.client) + f' lanes {requested}{lease}')
            except Exception as e:
                say(f'Lane renewal: {e}')
    thread = threading.Thread(target=renew, daemon=True); thread.start()
    try:
        yield
    finally:
        stopped.set()
        thread.join(timeout=2)
        # Cancellation must still clean up online devices. Offline cleanup gets
        # bounded attempts; only an explicitly requested lease expires.
        cleanup_args = argparse.Namespace(**vars(args)); cleanup_args.timeout = 10; cleanup_args.retries = 1
        cleanup = SSH(cleanup_args)
        old_lanes = previous.get('lanes', 1)
        remaining = previous.get('lanes_until', 0) - int(time.time())
        restored_lanes = old_lanes if not previous.get('lanes_until') or remaining > 0 else 1
        command = shlex.quote(args.client) + f' lanes {old_lanes}'
        if previous.get('lanes_until'):
            command = shlex.quote(args.client) + (f' lanes {old_lanes} {remaining}s' if remaining > 0 else ' lanes 1')
        was_stopped = STOP.is_set()
        STOP.clear()
        try:
            cleanup.run(command)
        except Exception as e:
            # A pooled control connection may itself use a lane being removed.
            # Its EOF can mean the command succeeded, not that restoration failed.
            try:
                actual = json.loads(cleanup.run(shlex.quote(args.client) + ' status --json'))
                if actual.get('lanes') != restored_lanes:
                    raise RuntimeError('lane count not restored')
            except Exception:
                recovery = 'extra lanes expire automatically' if lease else 'run devlink lanes 1 when reconnected'
                say(f'Could not confirm restored lane count ({recovery}): {e}')
        finally:
            if was_stopped: STOP.set()

def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('direction', choices=['push', 'pull'])
    parser.add_argument('source'); parser.add_argument('destination')
    parser.add_argument('--host', default='127.0.0.1')
    parser.add_argument('--port', type=int, required=True, help='Device origin reverse SSH port')
    parser.add_argument('--user', default='root'); parser.add_argument('--identity')
    parser.add_argument('--jobs', type=int, default=4)
    parser.add_argument('--lane-lease', default='', help='Optional extra-lane expiry, e.g. 15m; default no expiry')
    parser.add_argument('--client', default='/data/adb/modules/devlink/bin/devlink', help='On-device DevLink CLI path')
    parser.add_argument('--tunnels', type=int, default=4, help='Independent WebSocket/TCP lanes (1 for legacy SSH)')
    parser.add_argument('--chunk-size', type=int, default=8 * 1024 * 1024, help='Bytes per resumable chunk')
    parser.add_argument('--timeout', type=int, default=300, help='Timeout per SSH command, seconds')
    parser.add_argument('--retries', type=int, default=0, help='0 = retry transport failures indefinitely')
    parser.add_argument('--state-dir', default='~/.cache/devlink-transfer')
    parser.add_argument('--remote-state', default='/data/local/tmp/.devlink-transfer')
    parser.add_argument('--overwrite', action='store_true')
    parser.add_argument('--keep-chunks', action='store_true')
    args = parser.parse_args()
    if not 1 <= args.tunnels <= 16 or not 1 <= args.jobs <= 32 or not 1 <= args.chunk_size <= 64 * 1024 * 1024:
        parser.error('jobs must be 1..32; chunk-size must be 1..67108864')
    if not 1 <= args.port <= 65535 or args.timeout < 1 or args.retries < 0 or not args.remote_state.startswith('/'):
        parser.error('Invalid port, timeout, retries, or remote-state')
    def stop(signum, frame):
        STOP.set()
        raise KeyboardInterrupt()
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    try:
        ssh = SSH(args)
        with tunnel_lanes(args, ssh):
            transfer(args, ssh)
    except (KeyboardInterrupt, Cancelled):
        STOP.set(); say('Paused. Re-run this same command to resume verified chunks.'); return 130
    except Exception as e:
        STOP.set(); say(f'Error: {e}\nProgress retained; re-run after fixing the problem.'); return 1
    return 0

if __name__ == '__main__': sys.exit(main())

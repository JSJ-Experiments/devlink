--- a/src/svr-authpubkey.c
+++ b/src/svr-authpubkey.c
@@ -591,6 +591,13 @@ static int checkpubkeyperms() {
 			TRACE(("checkpubkeyperms: bad perm on %s", path))
 			ret = DROPBEAR_FAILURE;
 		}
+		/*
+		 * Android's root account home is /data, which is intentionally
+		 * group-writable. When root explicitly supplies an absolute -D
+		 * directory, validate that directory and authorized_keys but do not
+		 * reject Android's platform-managed parent directories.
+		 */
+		if (svr_opts.authorized_keys_dir[0] == '/' && strcmp(path, svr_opts.authorized_keys_dir) == 0) break;
 		if (strcmp(path, ses.authstate.pw_dir) == 0 || strcmp(path, "/") == 0) {
 			break;
 		}
